FROM jenkins/jenkins:lts-jdk21

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        chromium-driver \
        curl \
        ipmitool \
        python3 \
        python3-pip \
        python3-venv \
        qemu-system-arm \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

USER jenkins

RUN jenkins-plugin-cli --plugins \
    git \
    junit \
    workflow-aggregator
